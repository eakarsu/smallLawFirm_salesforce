    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.2.37",
    "@types/react-big-calendar": "^1.8.6",
    "@types/react-dom": "^18.2.15",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-config-next": "^15.5.16",
    "postcss": "^8.5.20",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.3.5",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.2.2"
  },
