# Core runtime (required)
DATABASE_URL="postgresql://app_user:replace-with-strong-password@db.example.com:5432/getfirmflow?sslmode=require"
# Optional pg_dump-compatible URL when DATABASE_URL contains Prisma-only query parameters
BACKUP_DATABASE_URL="postgresql://backup_user:replace-with-strong-password@db.example.com:5432/getfirmflow?sslmode=require"
NEXTAUTH_URL="https://firm.example.com"
NEXTAUTH_SECRET="replace-with-at-least-32-random-bytes"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"

# Governed revenue providers (all required for the full revenue lifecycle)
REVENUE_CRM_URL="https://crm-gateway.example.com"
REVENUE_CRM_TOKEN="replace-with-provider-token"
REVENUE_ENRICHMENT_URL="https://enrichment-gateway.example.com"
REVENUE_ENRICHMENT_TOKEN="replace-with-provider-token"
REVENUE_PRIVACY_URL="https://privacy-gateway.example.com"
REVENUE_PRIVACY_TOKEN="replace-with-provider-token"
REVENUE_EMAIL_URL="https://email-gateway.example.com"
REVENUE_EMAIL_TOKEN="replace-with-provider-token"
REVENUE_CALENDAR_URL="https://calendar-gateway.example.com"
REVENUE_CALENDAR_TOKEN="replace-with-provider-token"
REVENUE_HOURLY_LIMIT="100"

# Transactional email (required for password reset, verification, and invoices)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="GetFirmFlow <no-reply@example.com>"

# Optional controlled first-firm bootstrap; never used by startup
ALLOW_BOOTSTRAP_SEED="false"
BOOTSTRAP_FIRM_NAME="Example Law Firm"
BOOTSTRAP_FIRM_EMAIL="operations@example.com"
BOOTSTRAP_FIRM_TIMEZONE="America/New_York"
BOOTSTRAP_ADMIN_EMAIL="administrator@example.com"
BOOTSTRAP_ADMIN_FIRST_NAME="Firm"
BOOTSTRAP_ADMIN_LAST_NAME="Administrator"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-unique-strong-password"

UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"
